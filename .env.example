# System B (new-artist) environment variables
# Copy this file to .env and fill in real values from your second Turso DB.
# The Turso DB for this project must be `hedge-fund-experimental`, distinct from System A's `hedge-fund-namanvinayak`.

TURSO_DATABASE_URL=libsql://hedge-fund-experimental-namanvinayak.aws-us-east-1.turso.io
TURSO_AUTH_TOKEN=REPLACE_WITH_TOKEN_FROM_turso_db_tokens_create

# Optional Finnhub key (free tier; same key as System A is fine to reuse)
FINNHUB_API_KEY=
